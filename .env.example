# File: .env.example
# Copy to .env and adjust. docker-compose.yml reads these automatically.

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_TRANSACTIONS=transactions.raw

# --- Spark streaming job ---
CHECKPOINT_DIR=./checkpoints/fraud_stream
DELTA_OUTPUT_PATH=./delta/fraud_alerts
PROFILES_PATH=./data/risk_profiles.json
SPARK_TRIGGER_INTERVAL=10 seconds
STARTING_OFFSETS=latest
MAX_OFFSETS_PER_TRIGGER=50000

# --- Profile service ---
REDIS_URL=redis://localhost:6379/0
PROFILE_TTL_SECONDS=300
PROFILES_SEED_PATH=data/risk_profiles.json
PROFILE_SERVICE_PORT=8000

# --- Observability ---
LOG_LEVEL=INFO
